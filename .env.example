# Copy this file to ".env" and fill in the values.

# --- AI (get a key at console.anthropic.com) ---
# Without a key the site still works: AI features switch to a built-in "demo mode".
ANTHROPIC_API_KEY=
# Default is the most capable model. For a cheaper chat, set e.g. claude-sonnet-5-5 or claude-haiku-5-5.
ANTHROPIC_MODEL=claude-opus-5-5
# Hard cap on AI calls per day so a bot can't run up your bill.
DAILY_AI_CALL_LIMIT=300

# --- Server ---
# Local dev uses 8787 automatically. Hosting platforms set PORT for you.
# API_PORT=8787

# --- Where enquiries go ---
OWNER_EMAIL=hello@barvavision.com
# SMTP is optional. Without it, enquiries are still saved and visible at /#admin.
# Example (Brevo / SMTP2GO / Gmail app password):
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Barva Vision <hello@barvavision.com>"

# --- Admin page (/#admin) ---
# Choose a long random string. Leave empty to disable the admin page.
ADMIN_TOKEN=
